# ---------------------------------------------------------------------------
# Production configuration for a Linux VPS.
#
#   sudo -u ocr cp .env.production.example /opt/passport-ocr/.env
#   sudo -u ocr nano /opt/passport-ocr/.env        # set OCR_API_KEY + DOMAIN
#   sudo chmod 600 /opt/passport-ocr/.env
#
# This file holds a secret. It must be owned by the service user and readable
# by nobody else.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- OCR engine ------------------------------------------------------------
# THE ONE LINE THAT SWITCHES THE ENGINE.
#   paddle = real PaddleOCR (production)
#   stub   = scripted provider, no models loaded (development and CI only;
#            it returns only what a test scripted, so it is never a fallback
#            for real traffic)
OCR_PROVIDER=paddle

# Each language is a separate model in memory AND a separate full pass over
# every image. List only what you actually need.
OCR_LANGUAGES=en,arabic

OCR_USE_GPU=false
OCR_DET_LIMIT_SIDE_LEN=1600
OCR_DROP_SCORE=0.35

# Concurrent inferences per worker. Leave at 1: parallel inference inside one
# process multiplies peak memory and slows both requests down.
OCR_MAX_CONCURRENCY=1

# Inference threads inside one predictor. 1 is right when requests overlap.
OCR_CPU_THREADS=1

# Must be under the Nginx proxy_read_timeout (120s in deploy/nginx.conf).
OCR_TIMEOUT_SECONDS=45

# Load models during startup, not on the first request. systemd's
# TimeoutStartSec is set to 300s to allow for a cold model cache.
OCR_WARMUP_ON_STARTUP=true

# Model override. The defaults favour accuracy; the mobile variants are
# markedly faster on CPU. Recognition models are SCRIPT-SPECIFIC, so with more
# than one language use the per-language form or Arabic pages will be read with
# the Latin model and come back as nonsense. Validate on your own server before
# committing to either.
#   OCR_DET_MODEL_NAME=PP-OCRv5_mobile_det
#   OCR_REC_MODEL_NAME=en:PP-OCRv5_mobile_rec,arabic:arabic_PP-OCRv5_mobile_rec
OCR_DET_MODEL_NAME=
OCR_REC_MODEL_NAME=

# --- authentication --------------------------------------------------------
# REQUIRED. An empty value disables authentication entirely and the service
# logs a warning at startup.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma separated to rotate without downtime: add the new key, migrate the
# callers, then drop the old one.
OCR_API_KEY=CHANGE_ME
API_KEY_HEADER=X-API-Key

# --- server ----------------------------------------------------------------
# Loopback only. Nginx is the public entry point; the port must match both the
# systemd ExecStart and the Nginx upstream.
HOST=127.0.0.1
PORT=8000

# Each worker loads its OWN copy of every model. Start at 1 and raise only
# while you still have RAM headroom - see README "Performance".
WORKERS=1

# Nginx sets X-Forwarded-For. Without this the rate limiter would see every
# request as coming from 127.0.0.1 and throttle all callers as one.
TRUST_PROXY_HEADERS=true

# No interactive docs on a public deployment.
DOCS_ENABLED=false

# --- CORS and hosts --------------------------------------------------------
# Empty means no CORS headers, which is correct for server-to-server callers
# such as a backend application. Only set this if a browser calls the API.
ALLOWED_ORIGINS=
# Your domain, plus loopback. The loopback entries are not optional: systemd,
# monitoring and scripts/deploy.sh all probe http://127.0.0.1:8000/health, and
# TrustedHostMiddleware rejects any Host it was not given - so without them
# every local health check returns 400 "Invalid host header" and a deploy
# rolls itself back. The port is ignored during the comparison, and a host
# that is not listed is still rejected.
ALLOWED_HOSTS=ocr.example.com,127.0.0.1,localhost

# --- uploads ---------------------------------------------------------------
# Keep below the Nginx client_max_body_size (12m) so oversized uploads are
# rejected at the edge with the application's error shape still available.
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=50000000
TEMP_DIR=/tmp/document-ocr

# Privacy: uploads are processed in memory and discarded. Turning this on
# writes document images to disk - only do so with a retention policy.
STORE_UPLOADS=false
STORE_UPLOADS_DIR=/opt/passport-ocr/data/uploads

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Only needed once you run more than one worker; without it each worker
# enforces the limit independently.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# MUST stay false in production: it unmasks document content in the logs.
LOG_SENSITIVE_DATA=false
