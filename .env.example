# ---------------------------------------------------------------------------
# Document OCR service configuration.
# Copy to .env and adjust:   cp .env.example .env
# Every value below is optional; the defaults shown are what the service uses.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_VERSION=1.0.0

# --- authentication --------------------------------------------------------
# REQUIRED in any non-local deployment. Leaving it empty disables auth entirely
# and the service logs a warning at startup.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma separated values are accepted so keys can be rotated without downtime.
OCR_API_KEY=
API_KEY_HEADER=X-API-Key

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Each worker loads its own copy of the OCR models. See README "Performance".
WORKERS=1
ROOT_PATH=
# Interactive API docs at /docs. Turn off for anything public.
DOCS_ENABLED=true
# Only enable when the service actually sits behind a reverse proxy, otherwise
# X-Forwarded-For can be spoofed past the rate limiter.
TRUST_PROXY_HEADERS=false

# --- CORS and hosts (comma separated) --------------------------------------
# Empty means no CORS headers are sent at all, which is right for server-to-
# server use. Only fill this in if a browser calls the API directly.
ALLOWED_ORIGINS=
ALLOWED_HOSTS=*

# --- uploads ---------------------------------------------------------------
# 10 MB
MAX_UPLOAD_SIZE=10485760
MIN_UPLOAD_SIZE=256
# decompression-bomb guard
MAX_IMAGE_PIXELS=50000000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/bmp,image/tiff
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.bmp,.tif,.tiff
TEMP_DIR=/tmp/document-ocr

# Privacy: uploads are processed in memory and discarded. Only turn this on if
# you have a deliberate reason to retain images, and mind your retention policy.
STORE_UPLOADS=false
STORE_UPLOADS_DIR=./data/uploads

# --- OCR engine ------------------------------------------------------------
# paddle = PaddleOCR (default). stub = scripted provider for tests only.
OCR_PROVIDER=paddle
# Comma separated. "arabic" and "en" are the PaddleOCR model names;
# "ar"/"eng"/"english" are accepted aliases.
OCR_LANGUAGES=en,arabic
OCR_USE_GPU=false
OCR_DET_LIMIT_SIDE_LEN=1600
OCR_DROP_SCORE=0.35
OCR_MODEL_DIR=
# PaddleOCR 3.x model override. The defaults favour accuracy; the mobile
# variants are roughly 3x faster on CPU for a small accuracy cost.
#
# Recognition models are SCRIPT-SPECIFIC. With more than one language
# configured, use the per-language form or Arabic pages will be read with the
# Latin model and come back as transliterated nonsense:
#   OCR_DET_MODEL_NAME=PP-OCRv5_mobile_det
#   OCR_REC_MODEL_NAME=en:PP-OCRv5_mobile_rec,arabic:arabic_PP-OCRv5_mobile_rec
OCR_DET_MODEL_NAME=
OCR_REC_MODEL_NAME=
# Concurrent inferences per worker process. Raising this multiplies peak RAM
# and oversubscribes the CPU; see README "Performance".
OCR_MAX_CONCURRENCY=1
# Inference threads inside one predictor. 1 is right when several requests may
# overlap; raise it (2-4) to cut latency when documents arrive one at a time.
OCR_CPU_THREADS=1
OCR_TIMEOUT_SECONDS=45
# Load the models during startup rather than on the first request.
OCR_WARMUP_ON_STARTUP=true
INCLUDE_RAW_BLOCKS_DEFAULT=true

# --- image preprocessing ---------------------------------------------------
IMAGE_MAX_DIMENSION=2200
IMAGE_MIN_DIMENSION=320
ENABLE_PERSPECTIVE_CORRECTION=true
ENABLE_ORIENTATION_CORRECTION=true
ENABLE_DESKEW=true

# --- confidence thresholds -------------------------------------------------
MIN_FIELD_CONFIDENCE=0.40
# Responses below this get a "recognition confidence is low" warning.
MIN_OVERALL_CONFIDENCE=0.55

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Optional. Without it the limiter is per-process (fine for a single worker).
# REDIS_URL=redis://localhost:6379/0

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# NEVER enable in production: it unmasks document content in the logs.
LOG_SENSITIVE_DATA=false
